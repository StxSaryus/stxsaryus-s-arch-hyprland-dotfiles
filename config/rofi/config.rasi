/* ============================================================
   Rofi — Nocturne
   Colours and radii come from ../theme/colors.rasi.
   ============================================================ */

@theme "/dev/null"
@import "../theme/colors.rasi"

configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    display-drun:        "Apps";
    display-run:         "Run";
    display-window:      "Windows";
    drun-display-format: "{name}";
    font:                "JetBrainsMono Nerd Font 12";
    hover-select:        true;
    me-select-entry:     "";
    me-accept-entry:     "MousePrimary";
}

* {
    background-color: transparent;
    text-color:       @text;
}

window {
    width:            620px;
    background-color: @popup-bg;
    border:           1px;
    border-color:     @line;
    border-radius:    @radius-lg;
    padding:          0px;
}

mainbox {
    children: [ inputbar, message, listview ];
    padding:  0px;
    spacing:  0px;
}

/* ── Search field ─────────────────────────────────────────── */
inputbar {
    children:      [ prompt, entry ];
    padding:       16px 18px;
    spacing:       12px;
    border:        0px 0px 1px 0px;
    border-color:  @surface;
}

prompt {
    text-color:       @accent;
    vertical-align:   0.5;
}

entry {
    placeholder:        "Search";
    placeholder-color:  @muted;
    vertical-align:     0.5;
    cursor:             text;
}

/* ── Results ──────────────────────────────────────────────── */
listview {
    columns:      1;
    lines:        8;
    fixed-height: false;
    scrollbar:    false;
    padding:      8px;
    spacing:      2px;
    cycle:        true;
    dynamic:      true;
}

element {
    padding:       9px 12px;
    spacing:       12px;
    border-radius: @radius-sm;
    cursor:        pointer;
}

element normal normal,
element alternate normal {
    text-color: @subtext;
}

element selected normal,
element selected active {
    background-color: @accent-soft;
    text-color:       @accent;
}

element normal urgent,
element alternate urgent {
    text-color: @red;
}

element normal active,
element alternate active {
    text-color: @green;
}

element-icon {
    size:           26px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color:     inherit;
}

/* ── Messages (errors, prompts) ───────────────────────────── */
message {
    padding: 0px 18px 12px 18px;
}

textbox {
    text-color:       @muted;
    background-color: transparent;
    padding:          8px 12px;
    border-radius:    @radius-sm;
}
