@theme "/dev/null"

configuration {
    modi: "drun,run";
    show-icons: true;
    display-drun: " ";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    bg: #111111ee;
    fg: #ffffff;
    accent: #21ccff;
    button: #1e1e1e;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 40%;
    background-color: @bg;
    border: 1px;
    border-color: @accent;
    border-radius: 15px;
}

mainbox {
    children: [ inputbar, listview ];
}

inputbar {
    padding: 20px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
}

listview {
    columns: 1;
    lines: 8;
    fixed-height: false;
    padding: 10px;
}

element {
    padding: 10px;
    border-radius: 10px;
}

element selected {
    background-color: @accent;
    text-color: #000000;
}

element-icon {
    size: 24px;
    padding: 0 10px 0 0;
}
