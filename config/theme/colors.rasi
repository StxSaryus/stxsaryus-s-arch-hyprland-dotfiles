/* Generated by config/theme/build-theme.sh from palette.conf — do not edit. */

* {
    crust:   #07080b;
    base:    #0d0f14;
    mantle:  #11131a;
    surface: #1a1d26;
    overlay: #262a36;
    line:    #3a4152;

    text:    #e6e9f0;
    subtext: #b6bdcd;
    muted:   #7d8598;
    faint:   #4d5566;

    accent:      #33ccff;
    accent-deep: #1aa3d1;
    green:       #a6e3a1;
    yellow:      #f9e2af;
    red:         #f38ba8;

    popup-bg:    #0d0f14f0;
    card-bg:     #1a1d268c;
    hover-bg:    #262a36d9;
    accent-soft: #33ccff29;

    radius-sm: 8px;
    radius-md: 12px;
    radius-lg: 16px;
}
